# ============================================================================
# Variáveis de Ambiente - Supabase
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas credenciais do Supabase
# 3. Nunca commite o arquivo .env.local no Git
# ============================================================================

# URL do projeto Supabase
# Encontre em: https://app.supabase.com/project/[seu-project-id]/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima (Anon Key) do Supabase
# Encontre em: https://app.supabase.com/project/[seu-project-id]/settings/api
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# COMO ENCONTRAR SUAS CREDENCIAIS:
# ============================================================================
# 1. Acesse https://app.supabase.com/
# 2. Selecione seu projeto
# 3. Vá para "Settings" > "API"
# 4. Copie "Project URL" e "anon public" key
# ============================================================================
